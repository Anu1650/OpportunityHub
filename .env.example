# ---- Copy to .env and fill in real values. NEVER commit .env ----
# .env is already in .gitignore. This file is the safe template.

# --- App secrets ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=

# --- Database ---
# Leave BOTH blank to run locally on the in-memory store (zero setup).
# Set MONGO_URI to use MongoDB. Set GCP_PROJECT to use Firestore.
# MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/fitfest
# GCP_PROJECT=your-gcp-project-id

# --- Email (Gmail SMTP for OTP + password reset) ---
# Requires 2-Step Verification ON, then an App Password from
# https://myaccount.google.com/apppasswords
# If EMAIL_USER is blank, OTPs are shown in the UI instead of emailed.
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM="OpportunityHub <aniketigade@gmail.com>"

# --- Token lifetimes ---
OTP_TTL_MINUTES=10
SESSION_TTL_DAYS=30
