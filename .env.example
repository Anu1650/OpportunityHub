# ---- Copy to .env and fill in real values. NEVER commit .env ----
# .env is already in .gitignore. This file is the safe template.

# --- App secrets ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=

# --- Database ---
# Leave BOTH blank to run locally on the in-memory store (zero setup).
# Set MONGO_URI to use MongoDB. Set GCP_PROJECT to use Firestore.
# MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/fitfest
# GCP_PROJECT=your-gcp-project-id

# --- Email (Gmail SMTP for OTP + password reset) ---
# Required, because OTP codes are NEVER shown in the browser. Without working
# SMTP nobody can complete signup.
#
# 1) Turn on 2-Step Verification at https://myaccount.google.com/security
# 2) Create an App Password at  https://myaccount.google.com/apppasswords
#    (this is a 16-character code, NOT your Google account password)
# 3) Paste it below. Never commit this file.
#
# Every code is also printed to the server log, so you can still complete the
# flow while testing if mail delivery is slow.
EMAIL_USER=your.address@gmail.com
EMAIL_PASS=
EMAIL_FROM="OpportunityHub <your.address@gmail.com>"

# --- Token lifetimes ---
OTP_TTL_MINUTES=10
SESSION_TTL_DAYS=30
